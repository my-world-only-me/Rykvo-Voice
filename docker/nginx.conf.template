limit_conn_zone $server_name zone=rykvo_api_connections:64k;

server {
    listen ${NGINX_PORT} default_server;
    server_name _;
    charset utf-8;
    server_tokens off;
    autoindex off;

    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    add_header X-Frame-Options SAMEORIGIN always;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location ~ /\. {
        deny all;
    }
    location ~ ^/(gly/)?api/software-update/upload/chunk$ {
        client_max_body_size 1m;
        client_body_timeout 65s;
        proxy_request_buffering off;
        proxy_pass http://${RYKVO_HTTP_ADDR};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_send_timeout 70s;
        proxy_read_timeout 80s;
    }
    location ~ ^/(gly/)?api/v1(?:/|$) {
        limit_conn rykvo_api_connections 16;
        limit_conn_status 503;
        error_page 503 = @rykvo_api_busy;
        client_max_body_size 1600k;
        client_body_timeout 10s;
        proxy_request_buffering off;
        proxy_pass http://${RYKVO_HTTP_ADDR};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }
    location @rykvo_api_busy {
        default_type application/json;
        add_header Retry-After 1 always;
        add_header Cache-Control no-store always;
        return 503 '{"error":{"code":"API_BUSY"}}';
    }
    location / {
        client_max_body_size 1600k; # Each JSON API also enforces its own smaller limit.
        proxy_pass http://${RYKVO_HTTP_ADDR};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 3s;
        proxy_read_timeout 15s;
    }
}
